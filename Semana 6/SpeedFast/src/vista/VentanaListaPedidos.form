<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="vista.VentanaListaPedidos">
  <grid id="principal" binding="panelPrincipal" layout-manager="BorderLayout" hgap="12" vgap="12">
    <constraints>
      <xy x="20" y="20" width="900" height="420"/>
    </constraints>
    <properties/>
    <border type="empty">
      <size top="18" left="18" bottom="18" right="18"/>
    </border>
    <children>
      <component id="titulo" class="javax.swing.JLabel">
        <constraints border-constraint="North"/>
        <properties>
          <font size="18" style="1"/>
          <text value="SpeedFast — Listado de pedidos"/>
        </properties>
      </component>
      <scrollpane id="scroll">
        <constraints border-constraint="Center"/>
        <properties/>
        <border type="none"/>
        <children>
          <component id="tabla" class="javax.swing.JTable" binding="tablaPedidos">
            <constraints/>
            <properties>
              <fillsViewportHeight value="true"/>
            </properties>
          </component>
        </children>
      </scrollpane>
      <grid id="pie" layout-manager="BorderLayout" hgap="8" vgap="8">
        <constraints border-constraint="South"/>
        <properties/>
        <border type="none"/>
        <children>
          <component id="resumen" class="javax.swing.JLabel" binding="lblResumen">
            <constraints border-constraint="North"/>
            <properties>
              <text value="Sin pedidos registrados"/>
            </properties>
          </component>
          <grid id="acciones" layout-manager="FlowLayout" hgap="10" vgap="0" flow-align="2">
            <constraints border-constraint="South"/>
            <properties/>
            <border type="none"/>
            <children>
              <component id="reset" class="javax.swing.JButton" binding="btnReset">
                <constraints/>
                <properties>
                  <text value="Reset"/>
                </properties>
              </component>
              <component id="refrescar" class="javax.swing.JButton" binding="btnRefrescar">
                <constraints/>
                <properties>
                  <text value="Refrescar"/>
                </properties>
              </component>
              <component id="cerrar" class="javax.swing.JButton" binding="btnCerrar">
                <constraints/>
                <properties>
                  <text value="Cerrar"/>
                </properties>
              </component>
            </children>
          </grid>
        </children>
      </grid>
    </children>
  </grid>
</form>
